{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Gemini": {
    "Model": "gemini-3.6-flash",
    "HistoryRetentionDays": 3,
    "RetryMaxAttempts": 3,
    "RetryBaseDelayMilliseconds": 500
  },

  "GeminiRag": {
    "Model": "gemini-3.6-flash",
    "StoreDisplayName": "omms-rag-poc"
  },

  "Bedrock": {
    "Region": "ap-northeast-1",
    "ModelId": "jp.amazon.nova-2-lite-v1:0",
    "MaxOutputTokens": 800
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=omms;"
  }
}
