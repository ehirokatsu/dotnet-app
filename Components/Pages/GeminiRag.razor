@page "/gemini-rag"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using OMMS.Services
@inject GeminiRagService RagService

<PageTitle>Gemini RAG | OMMS</PageTitle>

<h1>Gemini RAG（無料枠PoC）</h1>
<p class="text-body-secondary">登録文書だけを検索し、根拠付きで回答します。</p>

<div class="alert alert-warning">
    無料枠では入力・登録文書・回答がGoogleの製品改善に利用される可能性があります。
    機密情報や個人情報は登録しないでください。RAG索引は削除操作を行うまでGoogle側に残ります。
    課金が有効なGoogle CloudプロジェクトのAPIキーを使う場合、この画面自体は課金を停止しません。
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert alert-success">@statusMessage</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header fw-semibold">1. 文書を登録</div>
            <div class="card-body">
                <InputFile class="form-control" OnChange="SelectFileAsync"
                           accept=".pdf,.txt,.md,.csv,.doc,.docx,.xls,.xlsx,.ppt,.pptx" disabled="@isBusy" />
                <div class="form-text">1ファイル10MBまで。PDF、テキスト、Office文書に対応します。</div>
                @if (selectedFile is not null)
                {
                    <p class="mt-2 mb-0">📎 @selectedFile.FileName (@FormatSize(selectedFile.Data.LongLength))</p>
                }
                <button class="btn btn-primary mt-3" @onclick="UploadAsync"
                        disabled="@(isBusy || selectedFile is null)">
                    @(isBusy ? "処理中..." : "RAGへ登録")
                </button>

                <hr />
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold">登録済み文書</span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync" disabled="@isBusy">更新</button>
                </div>
                @if (documents.Count == 0)
                {
                    <p class="text-body-secondary">登録文書はありません。</p>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var document in documents)
                        {
                            <li class="list-group-item d-flex justify-content-between gap-2">
                                <span>@document.DisplayName</span>
                                <small class="text-body-secondary">@document.State</small>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-semibold">2. 文書へ質問</div>
            <div class="card-body">
                <textarea class="form-control" rows="4" maxlength="@ChatInputPolicy.MaxLength"
                          @bind="question" placeholder="登録文書について質問してください"></textarea>
                <button class="btn btn-primary mt-3" @onclick="AskAsync" disabled="@isBusy">
                    @(isBusy ? "検索中..." : "RAG検索")
                </button>
                @if (!string.IsNullOrWhiteSpace(answer))
                {
                    <hr />
                    <h2 class="h5">回答</h2>
                    <div class="rag-answer">@answer</div>
                    @if (citations.Count > 0)
                    {
                        <h3 class="h6 mt-3">参照元</h3>
                        <ul>
                            @foreach (var citation in citations)
                            {
                                <li>@citation.FileName@(citation.PageNumber is null ? "" : $"（{citation.PageNumber}ページ）")</li>
                            }
                        </ul>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="card border-danger mt-4">
    <div class="card-header text-danger fw-semibold">Google側データの削除</div>
    <div class="card-body">
        <div class="form-check mb-2">
            <input id="confirm-delete-rag" class="form-check-input" type="checkbox" @bind="confirmDelete" />
            <label class="form-check-label" for="confirm-delete-rag">登録文書とRAG索引をすべて削除することを確認しました</label>
        </div>
        <button class="btn btn-outline-danger" @onclick="DeleteStoreAsync"
                disabled="@(isBusy || !confirmDelete)">RAGストアを削除</button>
    </div>
</div>

@code {
    private readonly List<GeminiRagDocument> documents = [];
    private readonly List<GeminiRagCitation> citations = [];
    private UploadFile? selectedFile;
    private string question = "";
    private string? answer;
    private string? errorMessage;
    private string? statusMessage;
    private bool confirmDelete;
    private bool isBusy;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task SelectFileAsync(InputFileChangeEventArgs args)
    {
        ClearMessages();
        var file = args.File;
        if (!GeminiRagService.TryResolveContentType(file.Name, out var contentType))
        {
            selectedFile = null;
            errorMessage = "対応していないファイル形式です。";
            return;
        }
        if (file.Size <= 0 || file.Size > GeminiRagService.MaxFileSize)
        {
            selectedFile = null;
            errorMessage = "ファイルは1バイト以上10MB以内にしてください。";
            return;
        }
        try
        {
            await using var source = file.OpenReadStream(GeminiRagService.MaxFileSize);
            using var memory = new MemoryStream();
            await source.CopyToAsync(memory);
            selectedFile = new UploadFile(Path.GetFileName(file.Name), contentType, memory.ToArray());
        }
        catch (IOException)
        {
            selectedFile = null;
            errorMessage = "ファイルを読み込めませんでした。";
        }
    }

    private async Task UploadAsync()
    {
        if (selectedFile is null) return;
        await RunBusyAsync(async () =>
        {
            var result = await RagService.UploadAsync(selectedFile.FileName, selectedFile.ContentType, selectedFile.Data);
            if (!result.IsSuccess) errorMessage = result.ErrorMessage;
            else
            {
                statusMessage = result.Message;
                selectedFile = null;
                await LoadDocumentsAsync();
            }
        });
    }

    private async Task AskAsync() => await RunBusyAsync(async () =>
    {
        var result = await RagService.AskAsync(question);
        if (!result.IsSuccess) errorMessage = result.ErrorMessage;
        else
        {
            answer = result.Answer;
            citations.Clear();
            citations.AddRange(result.Citations);
        }
    });

    private async Task RefreshAsync() => await RunBusyAsync(LoadDocumentsAsync);

    private async Task LoadDocumentsAsync()
    {
        documents.Clear();
        documents.AddRange(await RagService.ListDocumentsAsync());
    }

    private async Task DeleteStoreAsync() => await RunBusyAsync(async () =>
    {
        var result = await RagService.DeleteStoreAsync();
        if (!result.IsSuccess) errorMessage = result.ErrorMessage;
        else
        {
            statusMessage = result.Message;
            confirmDelete = false;
            documents.Clear();
            answer = null;
            citations.Clear();
        }
    });

    private async Task RunBusyAsync(Func<Task> action)
    {
        if (isBusy) return;
        isBusy = true;
        ClearMessages();
        try { await action(); }
        catch (Exception) { errorMessage = "処理に失敗しました。ネットワーク接続を確認してください。"; }
        finally { isBusy = false; }
    }

    private void ClearMessages()
    {
        errorMessage = null;
        statusMessage = null;
    }

    private static string FormatSize(long bytes) => $"{bytes / 1024d / 1024d:0.##} MB";
    private sealed record UploadFile(string FileName, string ContentType, byte[] Data);
}
