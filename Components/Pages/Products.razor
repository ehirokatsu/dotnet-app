@page "/products"
@rendermode InteractiveServer
@using OMMS.Models
@inject OMMS.Db.dao.ProductDao ProductDao

<PageTitle>商品管理 | OMMS</PageTitle>

<h1>商品管理</h1>

<p>商品の一覧を管理します。</p>

<button class="btn btn-primary mb-3" @onclick="ShowNewForm">
    新規商品登録
</button>

@if (showForm)
{
    <div class="card mb-4">
        <div class="card-body">
            <h3>@(editingProduct is null ? "商品登録" : "商品編集")</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <div class="mb-3">
                <label class="form-label">商品コード</label>
                <input class="form-control" @bind="newProductCode" />
            </div>

            <div class="mb-3">
                <label class="form-label">商品名</label>
                <input class="form-control" @bind="newProductName" />
            </div>

            <div class="mb-3">
                <label class="form-label">価格</label>
                <input type="number" class="form-control" @bind="newPrice" />
            </div>

            <button class="btn btn-success me-2" @onclick="SaveProductAsync">
                @(editingProduct is null ? "登録" : "更新")
            </button>
            <button class="btn btn-secondary" @onclick="CloseForm">
                キャンセル
            </button>
        </div>
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>商品コード</th>
            <th>商品名</th>
            <th>価格</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in products)
        {
            <tr>
                <td>@product.Code</td>
                <td>@product.Name</td>
                <td>@product.Price.ToString("N0") 円</td>
                <td>
                    <button class="btn btn-outline-primary btn-sm me-2"
                            @onclick="() => EditProduct(product)">
                        編集
                    </button>
                    <button class="btn btn-danger btn-sm"
                            @onclick="() => DeleteProductAsync(product.Id)">
                        削除
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<ProductBean> products = new();

    private bool showForm;
    private ProductBean? editingProduct;
    private string newProductCode = "";
    private string newProductName = "";
    private decimal newPrice;
    private string errorMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        products = await ProductDao.GetAllAsync();
    }

    private void ShowNewForm()
    {
        editingProduct = null;
        newProductCode = "";
        newProductName = "";
        newPrice = 0;
        errorMessage = "";
        showForm = true;
    }

    private void EditProduct(ProductBean product)
    {
        editingProduct = product;
        newProductCode = product.Code;
        newProductName = product.Name;
        newPrice = product.Price;
        errorMessage = "";
        showForm = true;
    }

    private void CloseForm()
    {
        showForm = false;
        editingProduct = null;
        errorMessage = "";
    }

    private async Task SaveProductAsync()
    {
        if (string.IsNullOrWhiteSpace(newProductCode) ||
            string.IsNullOrWhiteSpace(newProductName) ||
            newPrice <= 0)
        {
            errorMessage = "商品コード・商品名・0より大きい価格を入力してください。";
            return;
        }

        if (editingProduct is null)
        {
            // 新規登録
            var newProduct = new ProductBean
            {
                Code = newProductCode,
                Name = newProductName,
                Price = newPrice
            };
            await ProductDao.AddAsync(newProduct);
        }
        else
        {
            // 更新
            editingProduct.Code = newProductCode;
            editingProduct.Name = newProductName;
            editingProduct.Price = newPrice;
            await ProductDao.UpdateAsync(editingProduct);
        }

        CloseForm();
        await LoadProductsAsync();
    }

    private async Task DeleteProductAsync(int id)
    {
        await ProductDao.DeleteAsync(id);
        await LoadProductsAsync();
    }
}